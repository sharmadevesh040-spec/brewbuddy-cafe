# BrewBuddy Café — Environment Configuration
# Copy this file to .env and configure your secrets

# Server Port
PORT=5000

# Google Gemini API Key for Server-Side AI Barista
# Obtain your API key from https://aistudio.google.com/
# If left blank or unset, BrewBuddy falls back automatically to its verified catalog grounding engine.
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# Node Environment ('development' | 'production' | 'test')
NODE_ENV=development
